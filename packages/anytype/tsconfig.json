{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Types only, no runtime dependency. This adapter talks HTTP to the Anytype local
    // API, so it needs `fetch`/`AbortSignal` typings; @types/node describes those more
    // accurately for a Node-side adapter than pulling in the whole DOM lib would.
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../domain" }]
}
