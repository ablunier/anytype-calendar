{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // No ambient type packages. This is what makes the layer pure at compile time:
    // `process`, `fetch`, `document` and friends are simply not in scope here.
    "types": []
  },
  "include": ["src/**/*"],
  // Tests import vitest, which would otherwise be emitted into dist/ and would breach the
  // zero-dependency rule. Vitest transpiles them directly from source.
  "exclude": ["src/**/*.test.ts"]
}
