{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // No ambient type packages, as in every context: requests go through the injected client.
    "types": []
  },
  "include": ["infrastructure/**/*"],
  // Tests import vitest, which would otherwise be emitted into dist/. Vitest transpiles
  // them directly from source.
  "exclude": ["**/*.test.ts", "dist"],
  "references": [{ "path": "../anytype-client" }]
}
