{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // No ambient type packages and no DOM: `fetch` is typed structurally, so the client runs
    // on any platform that has one, and takes one injected where it has none.
    "types": []
  },
  "include": ["src/**/*"],
  // Tests import vitest, which would otherwise be emitted into dist/. Vitest transpiles
  // them directly from source.
  "exclude": ["**/*.test.ts", "dist"]
}
