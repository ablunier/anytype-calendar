{
  // Resolution-only tsconfig, consumed by dependency-cruiser (see .dependency-cruiser.cjs).
  // It maps the workspace scope onto package *sources* so the architecture lint can run
  // without a prior `tsc -b`. The real builds use project references and dist/ output,
  // so these paths are deliberately not part of tsconfig.base.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // `*` captures "<context>/<layer>", e.g. auth/domain.
      "@anytype-calendar/*": ["./packages/*/index.ts"],
      // The desktop app's internal aliases. Mirror apps/desktop's tsconfigs and the
      // electron.vite.config.ts resolve.alias — repeated here because dependency-cruiser
      // reads only this file, and would otherwise report every aliased import as
      // unresolvable.
      "@renderer/*": ["./apps/desktop/src/renderer/src/*"],
      "@shared/*": ["./apps/desktop/src/shared/*"]
    }
  }
}
