{
  "name": "@ablunier/anytype-calendar",
  "description": "Calendar for Anytype desktop app",
  "private": true,
  "author": {
    "name": "Adrian P. Blunier",
    "email": "adrianp@blunier.me"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w apps/desktop run dev",
    "start": "npm -w apps/desktop run start",
    "build": "tsc -b && npm -w apps/desktop run build",
    "package": "tsc -b && npm -w apps/desktop run package",
    "make": "tsc -b && npm -w apps/desktop run make",
    "publish": "tsc -b && npm -w apps/desktop run publish",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "lint:arch": "npm --prefix tools/arch-lint run cruise",
    "lint:arch:setup": "npm --prefix tools/arch-lint install",
    "clean": "tsc -b --clean && rm -rf apps/desktop/out apps/desktop/dist",
    "postinstall": "node node_modules/electron/install.js && npm --prefix tools/arch-lint install"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=26.8.1",
    "npm": ">=12.0.2"
  },
  "volta": {
    "node": "26.8.1",
    "npm": "12.0.2"
  }
}
