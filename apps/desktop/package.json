{
  "name": "anytype-calendar-desktop",
  "version": "1.0.0-beta.2",
  "description": "Calendar for Anytype desktop app",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Adrian P. Blunier",
    "email": "adrianp@blunier.me"
  },
  "main": "./out/main/index.js",
  "desktopName": "me.blunier.anytype.calendar.desktop",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "keywords": [],
  "dependencies": {
    "@ablunier/anytype-client": "^0.3.0",
    "@anytype-calendar/auth": "*",
    "@anytype-calendar/events": "*",
    "@anytype-calendar/feeds": "*",
    "@anytype-calendar/schema": "*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.9.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
