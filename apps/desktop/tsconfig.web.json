{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // See tsconfig.node.json: keeps `tsc -b` emit out of the source tree.
    "outDir": "dist/tsc-web",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/renderer/src/**/*"],
  "references": [{ "path": "../../packages/auth" }]
}
