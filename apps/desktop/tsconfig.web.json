{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // See tsconfig.node.json: keeps `tsc -b` emit out of the source tree.
    "outDir": "dist/tsc-web",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  // The preload's declaration file is what types `window.api` for the renderer.
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.json",
    "src/shared/**/*",
    "src/preload/index.d.ts"
  ],
  "references": [
    { "path": "../../packages/auth" },
    { "path": "../../packages/events" },
    { "path": "../../packages/schema" }
  ]
}
